{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ES2020",
    "outDir": "dist-electron",
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["electron"]
}
