{
  "name": "electron-video-downloader",
  "version": "1.0.0",
  "description": "An Electron + React video downloader application",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build",
    "preview": "vite preview",
    "package": "electron-builder"
  },
  "keywords": [
    "electron",
    "react",
    "video",
    "downloader"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.11",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ytdl-core": "^4.11.5"
  },
  "build": {
    "appId": "com.electron.videodownloader",
    "productName": "Video Downloader",
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "index.html"
    ],
    "directories": {
      "output": "release"
    }
  }
}
